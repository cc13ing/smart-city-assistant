
# AutoCityIntro 环境变量模板

# 复制为 .env 并填入真实密钥后运行: python run_all.py

# ===== 大模型（Kimi / Moonshot，聊天与意图识别必需）=====
OPENAI_API_KEY=sk-your-moonshot-api-key
OPENAI_BASE_URL=https://api.moonshot.cn/v1
OPENAI_MODEL=kimi-k2.6

# ===== 高德地图（路线/POI/天气必需）=====
AMAP_API_KEY=your-amap-backend-key
AMAP_JS_KEY=your-amap-js-key

# ===== 可选 =====
OPENWEATHER_API_KEY=your-openweather-key
MINIMAX_API_KEY=sk-your-minimax-key
MINIMAX_GROUP_ID=your-minimax-group-id
WEB_PORT=7003
MCP_SERVER_URL=http://localhost:7001
